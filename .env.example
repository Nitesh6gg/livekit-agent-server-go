# Copy to .env and fill in. Never commit .env — it holds real credentials.

# ─── LiveKit (media plane) ────────────────────────────────────────────────
LIVEKIT_URL=ws://192.168.36.20:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room the worker joins for the Phase 1 single-agent spike.
LIVEKIT_ROOM=agent-spike-1
LIVEKIT_IDENTITY=go-agent-worker

# ─── STT: Sarvam ──────────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=hi-IN

# Sarvam server-side VAD sensitivity (saaras:v3). Less trigger-happy than
# Sarvam's defaults so room noise is less likely to fire START_SPEECH.
STT_HIGH_VAD_SENSITIVITY=false
STT_POSITIVE_SPEECH_THRESHOLD=0.7
STT_NEGATIVE_SPEECH_THRESHOLD=0.5
STT_MIN_SPEECH_FRAMES=10

# ─── TTS: Sarvam ──────────────────────────────────────────────────────────
# The speaker must belong to the model's family: bulbul:v3 uses shubh, ritu,
# priya, kavya…; anushka is a bulbul:v2 voice.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
SARVAM_TTS_SAMPLE_RATE=24000

# ─── LLM: Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Local VAD (TEN VAD, via sherpa-onnx) ─────────────────────────────────
# Drives barge-in decisions locally instead of trusting Sarvam's START_SPEECH.
# The model must be sherpa's re-export of ten-vad.onnx; the one published by
# TEN itself carries no metadata and is rejected.
VAD_ENABLED=true
VAD_MODEL_PATH=models/ten-vad.onnx
# Speech probability (0..1) above which a frame counts as speech.
VAD_THRESHOLD=0.5
# Silence held before speech is considered over.
VAD_HANGOVER_MS=550
# Speech must last at least this long before it interrupts the agent.
VAD_MIN_SPEECH_MS=200

# ─── Speech enhancement (GTCRN, via sherpa-onnx) ──────────────────────────
# Denoises caller audio before both the VAD and Sarvam STT.
#
# Off by default. It adds one frame (16ms) of delay to the STT path, and
# changing what Sarvam hears carries real risk: ASR is trained on unprocessed
# audio, and over-suppression costs recognition accuracy. Turn it on as a
# measured experiment, then compare.
#
# It suppresses NOISE — fans, traffic, hum. It does not remove a second person
# talking across the room: that is speech, and the model preserves speech.
# See docs/DECISIONS.md ADR-018.
GTCRN_ENABLED=false
GTCRN_MODEL_PATH=models/gtcrn_simple.onnx

# ─── Runtime ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
HTTP_ADDR=:8080

# net/http/pprof on the ops server (/debug/pprof/). On by default: Phase 1 exists
# to produce the numbers in docs/METRICS.md and the CPU profile is one of them.
# Turn it OFF before this faces a network it does not own — pprof serves the
# command line, goroutine stacks and heap to anyone who can reach the port.
#
# It cannot see into cgo, so it will not break down sherpa-onnx or libopus time.
# That is what bench/ablate.sh is for.
PPROF_ENABLED=true
# Audio sample rate used inside the pipeline (Hz). TEN VAD and GTCRN are both
# 16 kHz only — unlike Silero, 8000 is no longer an option.
AUDIO_SAMPLE_RATE=16000
